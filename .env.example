# Copy to .env and fill in. Never commit .env.

# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=code_to_rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=code_to_rag
POSTGRES_PORT=5432
# Used by `pnpm dev` / tests outside Docker (compose builds its own URL).
DATABASE_URL=postgres://code_to_rag:change-me@localhost:5432/code_to_rag
# Separate database for integration tests (created by `pnpm db:test:create`).
TEST_DATABASE_URL=postgres://code_to_rag:change-me@localhost:5432/code_to_rag_test

# ── Secrets ───────────────────────────────────────────────────────────────
# 32 random bytes, base64: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the web app (used by authentication).
PUBLIC_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# After the first (administrator) account, allow anyone to sign up?
AUTH_ALLOW_SIGNUP=false

# ── Data and limits ───────────────────────────────────────────────────────
# Shared by web and worker. In development both run inside adapters/inbound/*, hence ../../../
DATA_DIR=../../../.data
ACQUISITION_MAX_ARCHIVE_MB=200
ACQUISITION_MAX_TOTAL_MB=1024
ACQUISITION_MAX_FILE_MB=1
ACQUISITION_MAX_FILES=50000
GIT_ALLOW_HTTP=false
GIT_CLONE_TIMEOUT=10 minutes

# ── Worker ────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2
JOB_MAX_ATTEMPTS=3

# ── Versions of the code ──────────────────────────────────────────────────
# Versions kept per project, the one in use included: older ones are deleted when a new version becomes current.
SNAPSHOT_RETENTION=3

# ── AI model (OpenAI-compatible API: Ollama, vLLM…; never the Vercel AI Gateway) ──
# Without AI_MODEL the "Genera schede" action and the chat are disabled. Read by the worker and by the web (chat).
# Ollama on the host: http://localhost:11434/v1 (from containers: http://host.docker.internal:11434/v1)
AI_BASE_URL=http://localhost:11434/v1
AI_PROVIDER_NAME=ollama
AI_MODEL=
# Only if the endpoint requires it.
AI_API_KEY=
# Send the JSON schema as response_format (Ollama and vLLM support it).
AI_STRUCTURED_OUTPUTS=true
AI_TIMEOUT=5 minutes
AI_MAX_RETRIES=2
# Model calls in parallel per worker process.
AI_CONCURRENCY=2
# Context window of the model (Ollama: OLLAMA_CONTEXT_LENGTH or num_ctx must be at least this).
AI_CONTEXT_TOKENS=16384
AI_MAX_OUTPUT_TOKENS=4096
# Length of a chat answer.
AI_CHAT_MAX_OUTPUT_TOKENS=1024
AI_TEMPERATURE=0.1

# ── Decision model (Ollama System One API: /v1/systemone) ─────────────────
# Required by the worker: it verifies the cards (probability that each statement is supported by the code).
# Ollama >= 0.35: `ollama pull d1-omni`. License of the d1 models: LFM Open License v1.0 (see docs/licenses.md).
# Ollama on the host: http://localhost:11434 (from containers: http://host.docker.internal:11434), no /v1.
DECISION_BASE_URL=http://localhost:11434
DECISION_MODEL=d1-omni
DECISION_TIMEOUT=2 minutes
DECISION_CONTEXT_TOKENS=12000
# Statement verdicts: supported at or above, unsupported below; missing rules suspected at or above.
VERIFY_SUPPORTED_THRESHOLD=0.7
VERIFY_UNSUPPORTED_THRESHOLD=0.3
VERIFY_MISSING_THRESHOLD=0.5

# ── Embeddings and RAG chat (OpenAI-compatible /v1/embeddings) ────────────
# Without EMBEDDING_MODEL there is no index and no chat. Use a multilingual model: cards are in English,
# questions are usually in Italian (Ollama: `ollama pull bge-m3`).
EMBEDDING_MODEL=
# Defaults to AI_BASE_URL / AI_API_KEY.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=16
# Cards given to the chat model per question; candidate chunks per search before the fusion.
RAG_TOP_CARDS=5
RAG_CANDIDATES=40
# Generated test questions: language and number per card.
TEST_QUESTIONS_LANGUAGE=Italian
TEST_QUESTIONS_PER_CARD=3

# ── Logging: json (production) or pretty (development) ───────────────────
LOG_FORMAT=pretty
